      "facetSimilarities": []
    },
    {
      "documentId": "4a1cc51c-4944-4d28-a752-df7c976537f8",
      "value": "Seeking to reduce the alarming number of deaths and serious injuries in the sport, Walter Camp (former captain of the Yale football team), suggested widening the field to open up the game.",
      "start": 697,
      "end": 885,
      "similarity": 0.07462906921324693,
      "facetSimilarities": []
    },
    {
      "documentId": "4a1cc51c-4944-4d28-a752-df7c976537f8",
      "value": "But the stadium was too narrow to accommodate a wider playing surface.",
