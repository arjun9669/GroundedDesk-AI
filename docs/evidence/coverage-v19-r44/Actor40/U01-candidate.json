    },
    {
      "documentId": "ba674cb4-c4c5-421e-b592-1556ba0797c0",
      "value": "The number of chloroplasts per cell varies from 1 in algae up to 100 in plants like Arabidopsis and wheat.",
      "start": 534,
      "end": 640,
      "similarity": 0.09221653968620412,
