    },
    {
      "documentId": "41a433eb-7128-4cd8-9495-ffa38552fe63",
      "value": "It was later called the \"first oil shock\", followed by the 1979 oil crisis, termed the \"second oil shock.\"",
      "start": 523,
      "end": 629,
      "similarity": 0.10150521091519099,
